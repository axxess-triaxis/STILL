{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://still.triaxisventures.com/schemas/envelope.v1.json",
  "title": "STILL event envelope v1",
  "description": "Carried as the EventBridge detail of every STILL event. Modelled on CloudEvents 1.0.",
  "type": "object",
  "required": ["specversion", "id", "source", "type", "time", "data"],
  "additionalProperties": false,
  "properties": {
    "specversion": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "source": {"type": "string", "pattern": "^triaxis\\.[a-z0-9-]+$"},
    "type": {"type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9]+)*\\.v[0-9]+$"},
    "time": {"type": "string", "format": "date-time"},
    "subject": {"type": "string", "maxLength": 256},
    "data": {"type": "object"}
  }
}
